{
  "name": "clearlist",
  "private": true,
  "engines": {
    "node": "^24.16.0"
  },
  "packageManager": "pnpm@11.3.0",
  "devDependencies": {
    "@clearlist/eslint-config": "workspace:*",
    "@clearlist/prettier-config": "workspace:*",
    "eslint": "^9.25.0",
    "prettier": "^3.8.3"
  },
  "scripts": {
    "auth:dev": "pnpm --filter @clearlist/auth dev",
    "auth:deploy": "pnpm --filter @clearlist/auth run build && pnpm --filter @clearlist/auth --prod deploy ./deploy/auth",
    "app:web": "pnpm --filter @clearlist/app web",
    "app:app": "pnpm --filter @clearlist/app native"
  }
}
