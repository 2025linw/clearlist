{
  "name": "compose",
  "private": true,
  "engines": {
    "node": "^24.16.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "auth:export": "pnpm --filter @compose/auth run export",
    "auth:migrate": "pnpm --filter @compose/auth run migrate",
    "auth:check": "pnpm --filter @compose/auth run check",
    "auth:lint": "pnpm --filter @compose/auth run lint",
    "auth:test": "pnpm --filter @compose/auth run test",

    "app:export-web": "pnpm --filter @compose/app run export:web",
    "app:check": "pnpm --filter @compose/app run check",
    "app:lint": "pnpm --filter @compose/app run lint",
    "app:test": "pnpm --filter @compose/app run test"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
