{
  "name": "@clearlist/app",
  "private": true,
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "dotenv -e .env.local -- expo start",
    "start-clean": "dotenv -e .env.local -- expo start --clear",
    "dev": "npm run start --",
    "prod": "dotenv -e .env.local -- expo start --no-dev",
    "export:web": "expo export --platform web",
    "format": "prettier src --check",
    "lint": "expo lint",
    "test": "jest"
  },
  "dependencies": {
    "@backpackapp-io/react-native-toast": "^0.15.1",
    "@better-auth/expo": "catalog:",
    "@expo/config-types": "^55.0.6",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/ui": "~57.0.26",
    "@react-native-vector-icons/ionicons": "^13.1.5",
    "@tanstack/react-query": "^5.105.0",
    "better-auth": "catalog:",
    "color": "^5.0.3",
    "dayjs": "^1.11.23",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-ui-datepicker": "^3.3.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@clearlist/tooling-config": "workspace:*",
    "@clearlist/types": "workspace:*",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "@types/react-native-vector-icons": "^6.4.18",
    "dotenv-cli": "^11.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "test-renderer": "1.2.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/|(?:jest-)?react-native(?:/|-)|@react-native(?:/|-)|@react-native-vector-icons/|expo(?:/|-)|@expo/|color(?:-(?:string|name|convert))?/))"
    ]
  }
}
