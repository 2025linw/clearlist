{
  "name": "@clearlist/auth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist/app.js",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "NODE_ENV=development ts-node src/app.ts",
    "dev": "npm run start",
    "prod": "npm run build && NODE_ENV=production node dist/app.js",
    "export": "npm run build",
    "migrate": "ts-node src/scripts/migrate.ts",
    "format": "prettier src --check",
    "lint": "eslint src",
    "test": "echo 'No tests created'"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "kysely": "^0.29.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@clearlist/tooling-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
