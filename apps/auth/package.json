{
  "name": "@clearlist/auth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist/app.js",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "NODE_ENV=development ts-node src/app.ts",
    "dev": "npm run start",
    "prod": "npm run build && NODE_ENV=production node dist/app.js",
    "export": "npm run build",
    "migrate": "ts-node src/scripts/migrate.ts",
    "tsc": "tsc",
    "format": "prettier src --check",
    "lint": "eslint src",
    "test": "echo 'No tests created'"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "better-auth": "catalog:",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "kysely": "^0.29.6",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@clearlist/eslint-config": "workspace:*",
    "@clearlist/prettier-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0"
  }
}
