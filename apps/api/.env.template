# API Server Config
SRV_PORT=SRV_PORT

ALLOWED_ORIGINS=ALLOWED_ORIGINS

# Auth Server Info (secrets must match between the API and auth servers)
AUTH_URL=AUTH_URL
WEBHOOK_SECRET="<32-char-length-secret>"

# Output
RUST_LOG=clearlist_api,tower_http=warn

# Database
MIGRATION_URL=postgresql://user:pass@host:port/db_name
DATABASE_URL=postgresql://user:pass@host:port/db_name
